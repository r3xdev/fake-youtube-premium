{
   "manifest_version": 3,
   "author": "r3xdev",
   "name": "Fake Youtube Premium",
   "version": "1.1",
   "description": "Swap the YouTube logo to the Premium version.",
   "action": {
      "default_icon": {
         "48": "icons/icon48.png",
         "128": "icons/icon128.png"
      },
      "default_title": "Fake Youtube Premium",
      "default_popup": "popup.html"
   },
   "permissions": [
      "tabs",
      "storage"
   ],
   "background": {
      "service_worker": "background.js"
   },
   "homepage_url": "https://github.com/r3xdev",
   "content_scripts": [
      {
         "exclude_matches": [ "*://*.music.youtube.com/*" ],
         "all_frames": false,
         "js": [
            "anu.js"
         ],
         "matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"]
      }
   ],
   "host_permissions": ["*://*.youtube.com/*"],
   "icons": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   }
}
